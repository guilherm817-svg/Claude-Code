# Copie para .env e preencha. Tudo é opcional para testar no computador.

# Endereço público (https) onde o Rastro roda. Vai nas URLs de webhook e no script do pixel.
# Ex.: https://rastro.suaempresa.com.br
RASTRO_URL_PUBLICA=

# Banco de dados. Vazio = SQLite em dados/rastro.db (bom para começar).
# Em produção, use PostgreSQL: postgresql://usuario:senha@host:5432/rastro
DATABASE_URL=

# Opcionais
# RASTRO_CHAVE_SECRETA=           assina os cookies de login (gerada sozinha em dados/chave_secreta)
# RASTRO_PERMITIR_CADASTRO=0      1 = qualquer visitante pode criar uma conta nova (modo SaaS)
# RASTRO_SINCRONIZAR_MINUTOS=15   intervalo da sincronização com o Meta Ads (mínimo 5)
# RASTRO_SINCRONIZAR=1            0 desliga a sincronização automática
# RASTRO_META_VERSAO_API=v25.0    versão da Graph API do Meta
# RASTRO_CONFIAR_PROXY=1          1 = lê o IP real do X-Forwarded-For (atrás de Caddy, Nginx, Railway...)
# RASTRO_PASTA_DADOS=dados        onde ficam o SQLite e a chave secreta
# PORT=8000
